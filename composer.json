{
    "name": "vcorexplatform/framework",
    "description": "Starter PHP MVC application template",
    "type": "project",
    "require": {
        "php": "^8.4",
        "vcorexplatform/core": "^1.0",
        "vcorexplatform/session": "^1.0",
        "vcorexplatform/http-client": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {"test": "@php tests/install.php"},
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": false,
                "versions": {
                    "vcorexplatform/core": "1.0.0",
                    "vcorexplatform/session": "1.0.0",
                    "vcorexplatform/http-client": "1.0.0"
                }
            }
        }
    ]
}
